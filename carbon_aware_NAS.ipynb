      "source": [
        "\n",
        "!pip install medmnist -q\n",
        "\n",
        "import os\n",
        "import random\n",
        "import numpy as np\n",
        "import pandas as pd\n",
        "from collections import defaultdict\n",
        "\n",
        "import torch\n",
        "import torch.nn as nn\n",
        "import torch.optim as optim\n",
        "from torch.utils.data import DataLoader, Subset\n",
        "\n",
        "import medmnist\n",
        "from medmnist import INFO\n",
        "\n",
        "\n",
        "SEED = 42\n",
        "random.seed(SEED)\n",
        "np.random.seed(SEED)\n",
        "torch.manual_seed(SEED)\n",
        "\n",
        "device = torch.device(\"cuda\" if torch.cuda.is_available() else \"cpu\")\n",
        "print(\"Device:\", device)\n",
        "\n",
        "\n",
        "DATA_FLAG = \"pathmnist\"\n",
        "NUM_CLIENTS = 20\n",
        "NUM_ROUNDS = 5\n",
        "LOCAL_EPOCHS_MAX = 3\n",
        "BATCH_SIZE = 64\n",
        "\n",
        "POPULATION_SIZE = 6\n",
        "GENERATIONS = 2\n",
        "TOP_K = 16\n",
        "\n",
        "LR = 0.001\n",
        "\n",
        "# Fitness weights\n",
        "BETA_ACC = 0.55\n",
        "BETA_PART = 0.30\n",
        "BETA_CARBON = 0.15\n",
        "\n",
        "# Scheduler weights\n",
        "LAMBDA_BUDGET = 0.4\n",
        "LAMBDA_DATA = 0.3\n",
        "LAMBDA_EFF = 0.3\n",
        "\n",
        "# Load MedMNIST Dataset\n",
        "\n",
        "info = INFO[DATA_FLAG]\n",
        "DataClass = getattr(medmnist, info[\"python_class\"])\n",
        "NUM_CLASSES = len(info[\"label\"])\n",
        "N_CHANNELS = info[\"n_channels\"]\n",
        "\n",
        "train_dataset = DataClass(split=\"train\", download=True)\n",
        "test_dataset = DataClass(split=\"test\", download=True)\n",
        "\n",
        "def transform_x(x):\n",
        "    x = torch.tensor(np.array(x), dtype=torch.float32)\n",
        "    if x.ndim == 2:\n",
        "        x = x.unsqueeze(0)\n",
        "    else:\n",
        "        x = x.permute(2, 0, 1)\n",
        "    return x / 255.0\n",
        "\n",
        "class MedMNISTWrapper(torch.utils.data.Dataset):\n",
        "    def __init__(self, dataset):\n",
        "        self.dataset = dataset\n",
        "\n",
        "    def __len__(self):\n",
        "        return len(self.dataset)\n",
        "\n",
        "    def __getitem__(self, idx):\n",
        "        x, y = self.dataset[idx]\n",
        "        x = transform_x(x)\n",
        "        y = torch.tensor(y).long().view(-1)[0]\n",
        "        return x, y\n",
        "\n",
        "train_dataset = MedMNISTWrapper(train_dataset)\n",
        "test_dataset = MedMNISTWrapper(test_dataset)\n",
        "\n",
        "test_loader = DataLoader(test_dataset, batch_size=256, shuffle=False)\n",
        "\n",
        "# -----------------------------\n",
        "# Non-IID Client Partition\n",
        "# -----------------------------\n",
        "def create_non_iid_clients(dataset, num_clients):\n",
        "    label_to_indices = defaultdict(list)\n",
        "\n",
        "    for idx in range(len(dataset)):\n",
        "        _, y = dataset[idx]\n",
        "        label_to_indices[int(y)].append(idx)\n",
        "\n",
        "    for y in label_to_indices:\n",
        "        random.shuffle(label_to_indices[y])\n",
        "\n",
        "    client_indices = [[] for _ in range(num_clients)]\n",
        "\n",
        "    for label, indices in label_to_indices.items():\n",
        "        chunks = np.array_split(indices, num_clients)\n",
        "        for i in range(num_clients):\n",
        "            client_indices[i].extend(chunks[i].tolist())\n",
        "\n",
        "    for i in range(num_clients):\n",
        "        random.shuffle(client_indices[i])\n",
        "\n",
        "    return client_indices\n",
        "\n",
        "client_indices = create_non_iid_clients(train_dataset, NUM_CLIENTS)\n",
        "\n",
        "client_loaders = []\n",
        "client_data_sizes = []\n",
        "\n",
        "for idxs in client_indices:\n",
        "    subset = Subset(train_dataset, idxs)\n",
        "    loader = DataLoader(subset, batch_size=BATCH_SIZE, shuffle=True)\n",
        "    client_loaders.append(loader)\n",
        "    client_data_sizes.append(len(subset))\n",
        "\n",
        "client_data_sizes = np.array(client_data_sizes)\n",
        "\n",
        "#  Consumer Profiles\n",
        "eta = np.random.uniform(2.0, 5.0, NUM_CLIENTS)        # GFLOPs/J\n",
        "carbon_budget = np.random.uniform(800, 2000, NUM_CLIENTS)\n",
        "rho = np.random.uniform(0.5, 1.5, NUM_CLIENTS)\n",
        "\n",
        "def carbon_intensity(round_id):\n",
        "    return np.random.uniform(150, 500, NUM_CLIENTS)\n",
        "\n",
        "# -----------------------------\n",
        "# Search Space\n",
        "# -----------------------------\n",
        "search_space = {\n",
        "    \"depth\": [2, 3, 4],\n",
        "    \"width\": [16, 32, 64],\n",
        "    \"kernel\": [3, 5],\n",
        "    \"operator\": [\"conv\", \"dwconv\"],\n",
        "    \"sparsity\": [0.0, 0.25, 0.5],\n",
        "    \"precision\": [16, 32]\n",
        "}\n",
        "\n",
        "def sample_architecture():\n",
        "    return {\n",
        "        \"depth\": random.choice(search_space[\"depth\"]),\n",
        "        \"width\": random.choice(search_space[\"width\"]),\n",
        "        \"kernel\": random.choice(search_space[\"kernel\"]),\n",
        "        \"operator\": random.choice(search_space[\"operator\"]),\n",
        "        \"sparsity\": random.choice(search_space[\"sparsity\"]),\n",
        "        \"precision\": random.choice(search_space[\"precision\"])\n",
        "    }\n",
        "\n",
        "def estimate_flops_params(arch):\n",
        "    d = arch[\"depth\"]\n",
        "    w = arch[\"width\"]\n",
        "    k = arch[\"kernel\"]\n",
        "    sparsity = arch[\"sparsity\"]\n",
        "    precision = arch[\"precision\"]\n",
        "    op_factor = 0.35 if arch[\"operator\"] == \"dwconv\" else 1.0\n",
        "    precision_factor = precision / 32\n",
        "\n",
        "    flops = d * w * w * k * k * op_factor * (1 - sparsity) * 0.001\n",
        "    params = d * w * w * k * k * op_factor * (1 - sparsity) * precision_factor * 0.0001\n",
        "\n",
        "    return flops, params\n",
        "\n",
        "\n",
        "class NASCNN(nn.Module):\n",
        "    def __init__(self, arch):\n",
        "        super().__init__()\n",
        "\n",
        "        layers = []\n",
        "        in_channels = N_CHANNELS\n",
        "        width = arch[\"width\"]\n",
        "        kernel = arch[\"kernel\"]\n",
        "        padding = kernel // 2\n",
        "\n",
        "        for _ in range(arch[\"depth\"]):\n",
        "            if arch[\"operator\"] == \"dwconv\" and in_channels == width:\n",
        "                layers.append(nn.Conv2d(in_channels, in_channels, kernel, padding=padding, groups=in_channels))\n",
        "                layers.append(nn.Conv2d(in_channels, width, 1))\n",
        "            else:\n",
        "                layers.append(nn.Conv2d(in_channels, width, kernel, padding=padding))\n",
        "\n",
        "            layers.append(nn.BatchNorm2d(width))\n",
        "            layers.append(nn.ReLU())\n",
        "            layers.append(nn.MaxPool2d(2))\n",
        "            in_channels = width\n",
        "\n",
        "        self.features = nn.Sequential(*layers)\n",
        "        self.pool = nn.AdaptiveAvgPool2d((1, 1))\n",
        "        self.classifier = nn.Linear(width, NUM_CLASSES)\n",
        "\n",
        "    def forward(self, x):\n",
        "        x = self.features(x)\n",
        "        x = self.pool(x)\n",
        "        x = x.view(x.size(0), -1)\n",
        "        return self.classifier(x)\n",
        "\n",
        "\n",
        "def carbon_cost(arch, client_id, epochs, ci_t):\n",
        "    flops, params = estimate_flops_params(arch)\n",
        "\n",
        "    train_carbon = (epochs * flops * client_data_sizes[client_id] / eta[client_id]) * ci_t[client_id] * 1e-6\n",
        "    comm_carbon = (rho[client_id] * params) * ci_t[client_id] * 1e-3\n",
        "\n",
        "    return train_carbon + comm_carbon\n",
        "\n",
        "def allocate_epochs(client_id, remaining_budget):\n",
        "    epoch = int(max(1, np.floor(LOCAL_EPOCHS_MAX * remaining_budget[client_id] / carbon_budget[client_id])))\n",
        "    return epoch\n",
        "\n",
        "def carbon_aware_scheduler(arch, remaining_budget, round_id):\n",
        "    ci_t = carbon_intensity(round_id)\n",
        "    feasible_clients = []\n",
        "\n",
        "    for i in range(NUM_CLIENTS):\n",
        "        e_i = allocate_epochs(i, remaining_budget)\n",
        "        cost = carbon_cost(arch, i, e_i, ci_t)\n",
        "\n",
        "        if cost <= remaining_budget[i]:\n",
        "            feasible_clients.append(i)\n",
        "\n",
        "    if len(feasible_clients) == 0:\n",
        "        return [], {}, ci_t\n",
        "\n",
        "    scores = {}\n",
        "\n",
        "    for i in feasible_clients:\n",
        "        carbon_availability = remaining_budget[i] / carbon_budget[i]\n",
        "        data_contribution = client_data_sizes[i] / np.sum(client_data_sizes)\n",
        "        carbon_efficiency = eta[i] / ci_t[i]\n",
        "\n",
        "        score = (\n",
        "            LAMBDA_BUDGET * carbon_availability +\n",
        "            LAMBDA_DATA * data_contribution +\n",
        "            LAMBDA_EFF * carbon_efficiency\n",
        "        )\n",
        "\n",
        "        scores[i] = score\n",
        "\n",
        "    selected_clients = sorted(scores, key=scores.get, reverse=True)[:TOP_K]\n",
        "\n",
        "    epoch_plan = {}\n",
        "    for i in selected_clients:\n",
        "        epoch_plan[i] = allocate_epochs(i, remaining_budget)\n",
        "\n",
        "    return selected_clients, epoch_plan, ci_t\n",
        "\n",
        "\n",
        "def local_train(model, loader, epochs):\n",
        "    model.train()\n",
        "    optimizer = optim.Adam(model.parameters(), lr=LR)\n",
        "    criterion = nn.CrossEntropyLoss()\n",
        "\n",
        "    for _ in range(epochs):\n",
        "        for x, y in loader:\n",
        "            x, y = x.to(device), y.to(device)\n",
        "\n",
        "            optimizer.zero_grad()\n",
        "            output = model(x)\n",
        "            loss = criterion(output, y)\n",
        "            loss.backward()\n",
        "            optimizer.step()\n",
        "\n",
        "    return model.state_dict()\n",
        "\n",
        "def fedavg(state_dicts, weights):\n",
        "    avg_state = {}\n",
        "\n",
        "    for key in state_dicts[0].keys():\n",
        "        avg_state[key] = sum(\n",
        "            state_dicts[i][key] * weights[i]\n",
        "            for i in range(len(state_dicts))\n",
        "        )\n",
        "\n",
        "    return avg_state\n",
        "\n",
        "def evaluate(model):\n",
        "    model.eval()\n",
        "    correct = 0\n",
        "    total = 0\n",
        "\n",
        "    with torch.no_grad():\n",
        "        for x, y in test_loader:\n",
        "            x, y = x.to(device), y.to(device)\n",
        "            output = model(x)\n",
        "            pred = output.argmax(dim=1)\n",
        "            correct += (pred == y).sum().item()\n",
        "            total += y.size(0)\n",
        "\n",
        "    return 100 * correct / total\n",
        "\n",
        "def evaluate_architecture(arch):\n",
        "    global_model = NASCNN(arch).to(device)\n",
        "    remaining_budget = carbon_budget.copy()\n",
        "\n",
        "    total_selected = 0\n",
        "    total_violations = 0\n",
        "    round_accuracies = []\n",
        "    carbon_utilities = []\n",
        "\n",
        "    for t in range(NUM_ROUNDS):\n",
        "        selected_clients, epoch_plan, ci_t = carbon_aware_scheduler(arch, remaining_budget, t)\n",
        "\n",
        "        if len(selected_clients) == 0:\n",
        "            continue\n",
        "\n",
        "        local_states = []\n",
        "        local_weights = []\n",
        "\n",
        "        for client_id in selected_clients:\n",
        "            local_model = NASCNN(arch).to(device)\n",
        "            local_model.load_state_dict(global_model.state_dict())\n",
        "\n",
        "            e_i = epoch_plan[client_id]\n",
        "            cost = carbon_cost(arch, client_id, e_i, ci_t)\n",
        "\n",
        "            if cost > remaining_budget[client_id]:\n",
        "                total_violations += 1\n",
        "                continue\n",
        "\n",
        "            state = local_train(local_model, client_loaders[client_id], e_i)\n",
        "            local_states.append(state)\n",
        "            local_weights.append(client_data_sizes[client_id])\n",
        "\n",
        "            remaining_budget[client_id] -= cost\n",
        "            total_selected += 1\n",
        "\n",
        "        if len(local_states) > 0:\n",
        "            local_weights = np.array(local_weights) / np.sum(local_weights)\n",
        "            new_state = fedavg(local_states, local_weights)\n",
        "            global_model.load_state_dict(new_state)\n",
        "\n",
        "        acc = evaluate(global_model)\n",
        "        round_accuracies.append(acc)\n",
        "\n",
        "        carbon_utility = np.mean(remaining_budget / carbon_budget)\n",
        "        carbon_utilities.append(carbon_utility)\n",
        "\n",
        "    final_accuracy = round_accuracies[-1] if round_accuracies else 0\n",
        "    participation = 100 * total_selected / (NUM_ROUNDS * NUM_CLIENTS)\n",
        "    violation = 100 * total_violations / max(total_selected + total_violations, 1)\n",
        "\n",
        "    fitness = (\n",
        "        BETA_ACC * (final_accuracy / 100) +\n",
        "        BETA_PART * (participation / 100) +\n",
        "        BETA_CARBON * np.mean(carbon_utilities)\n",
        "    )\n",
        "\n",
        "    return {\n",
        "        \"Architecture\": str(arch),\n",
        "        \"Accuracy (%)\": final_accuracy,\n",
        "        \"Participation (%)\": participation,\n",
        "        \"Violation (%)\": violation,\n",
        "        \"Fitness\": fitness\n",
        "    }\n",
        "\n",
        "# -----------------------------\n",
        "# Evolutionary NAS\n",
        "# -----------------------------\n",
        "population = [sample_architecture() for _ in range(POPULATION_SIZE)]\n",
        "all_results = []\n",
        "\n",
        "for generation in range(GENERATIONS):\n",
        "    print(f\"\\nGeneration {generation + 1}/{GENERATIONS}\")\n",
        "\n",
        "    generation_results = []\n",
        "\n",
        "    for arch in population:\n",
        "        result = evaluate_architecture(arch)\n",
        "        result[\"Generation\"] = generation + 1\n",
        "        generation_results.append(result)\n",
        "        all_results.append(result)\n",
        "\n",
        "        print(result)\n",
        "\n",
        "    generation_results = sorted(generation_results, key=lambda x: x[\"Fitness\"], reverse=True)\n",
        "    elites = generation_results[:2]\n",
        "\n",
        "    new_population = []\n",
        "\n",
        "    for elite in elites:\n",
        "        arch = eval(elite[\"Architecture\"])\n",
        "        new_population.append(arch)\n",
        "\n",
        "    while len(new_population) < POPULATION_SIZE:\n",
        "        parent = eval(random.choice(elites)[\"Architecture\"])\n",
        "        child = parent.copy()\n",
        "\n",
        "        mutation_key = random.choice(list(search_space.keys()))\n",
        "        child[mutation_key] = random.choice(search_space[mutation_key])\n",
        "\n",
        "        new_population.append(child)\n",
        "\n",
        "    population = new_population\n",
        "\n",
        "\n",
        "df_all = pd.DataFrame(all_results)\n",
        "best = df_all.sort_values(\"Fitness\", ascending=False).iloc[0]\n",
        "\n",
        "final_result = pd.DataFrame([{\n",
        "    \"Method\": \"Ours\",\n",
        "    \"Dataset\": DATA_FLAG,\n",
        "    \"Accuracy (%)\": round(best[\"Accuracy (%)\"], 2),\n",
        "    \"Participation (%)\": round(best[\"Participation (%)\"], 2),\n",
        "    \"Violation (%)\": round(best[\"Violation (%)\"], 2),\n",
        "    \"Best Architecture\": best[\"Architecture\"],\n",
        "    \"Fitness\": round(best[\"Fitness\"], 4)\n",
        "}])\n",
        "\n",
        "final_result.to_csv(\"ours_framework_medmnist_results.csv\", index=False)\n",
        "\n",
        "final_result"
      ]
    }
  ],
